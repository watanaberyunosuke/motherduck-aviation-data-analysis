# Warehouse target. A local DuckDB file by default; set to md:aviation to use MotherDuck
# (then MOTHERDUCK_TOKEN is also required).
WAREHOUSE=data/aviation.duckdb
MOTHERDUCK_TOKEN=

# OpenSky Network API client (OAuth2 client credentials).
# Create at https://opensky-network.org -> Account -> API client.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# FAA NOTAM API (free). Register at https://api.faa.gov/s/ and request the NOTAM API.
# Only needed for airports with notam_source: faa (none at present; the FAA NOTAM Search
# source needs no key). Without it that step is skipped.
FAA_CLIENT_ID=
FAA_CLIENT_SECRET=

# RapidAPI key for the SkyLink API (paid). Only needed if an airport in config/airports.yml
# uses notam_source: rapidapi; none do at present.
# RAPIDAPI_KEY=
